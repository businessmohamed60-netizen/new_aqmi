DirectoryIndex index.php index.html

RewriteEngine On
Options -Indexes

# Serve real static files directly (assets, images, css, js)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(css|js|png|jpe?g|gif|ico|svg|woff2?|ttf|eot|webp|pdf)$ - [L]

# Serve standalone HTML pages directly (asin.html, lms.html, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.html$ - [L]

# Route everything else through index.php (the PHP application)
RewriteCond %{REQUEST_URI} !^/index\.php
RewriteRule ^(.*)$ index.php [QSA,L]
