{
    "name": "aqmi/aqmi",
    "description": "Automotive Quality Maturity Index - Plateforme d'auto-évaluation de la maturité qualité",
    "type": "project",
    "keywords": ["quality", "maturity", "assessment", "automotive"],
    "homepage": "https://aqmi.com",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^2.0",
        "phpmailer/phpmailer": "*",
        "endroid/qr-code": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "chmod -R 775 storage/ public/uploads/"
        ],
        "post-update-cmd": [
            "chmod -R 775 storage/ public/uploads/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
